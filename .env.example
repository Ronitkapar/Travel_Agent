# --- Required for every planning run ---------------------------------------

# LLM provider. The default model must exist for your Groq account; if you see
# `model_not_found`, list what your key can use:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
GROQ_API_KEY=
# Optional override for the model id.
# GROQ_MODEL=openai/gpt-oss-120b

# Tavily web search, reached over MCP streamable HTTP.
TAVILY_API_KEY=

# AviationStack airport/airline data, reached over MCP stdio via `uvx`.
# The historical spelling AVIATIONSTACK_API_KEY is also accepted.
AVIATION_STACK_API_KEY=

# OpenWeather, used by the bundled weather MCP server.
OPENWEATHER_API_KEY=

# --- Persistence (optional) -------------------------------------------------

# When unset, thread/checkpoint state is kept in process memory only and is
# lost on restart. Set a PostgreSQL URL to make the human-in-the-loop approval
# flow survive restarts. sslmode=require is appended automatically if absent.
#
# Supabase projects on IPv6-only plans publish no A record, so the direct host
# (db.<ref>.supabase.co) is unreachable from IPv4-only hosts. Use the IPv4
# connection pooler instead:
#
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Region and project-ref come from Project Settings -> Database. The schema is
# created automatically on first run; no migration step is needed.
# DATABASE_URL=postgresql://postgres.abc123:password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# --- Observability (optional) ------------------------------------------------

# Pydantic Logfire write token. Tracing is disabled when this is unset, and the
# app starts normally either way. Find it in Project Settings -> Logfire ->
# "Add data" -> Python -> write token.
# LOGFIRE_TOKEN=

# Reported in the Logfire UI so local and deployed traces can be told apart.
# LOGFIRE_ENVIRONMENT=local

# --- HTTP server -----------------------------------------------------------

# Render injects PORT automatically; the defaults below suit local runs.
# HOST=0.0.0.0
# PORT=8000
# LOG_LEVEL=info

# Comma-separated browser origins allowed to call this API. Set this to your
# Vercel deployment URL when the frontend is hosted separately.
# Entries must be bare origins: scheme://host[:port], with no path, trailing
# text, or markdown. Anything else is ignored with a warning.
# CORS_ORIGINS=http://localhost:8000,https://your-app.vercel.app

# Optional override for the bundled weather MCP server entrypoint.
# Defaults to the copy inside the installed package.
# WEATHER_SERVER_PATH=

# Optional override for the static frontend directory (the one holding
# index.html). Auto-detected for a normal checkout; only set this if you deploy
# the package without the repository's frontend/ directory.
# FRONTEND_DIR=